        </mxCell>
        <mxCell id="b_p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" value="optimizer.zero_grad(set_to_none=True)" vertex="1">
          <mxGeometry height="50" width="240" x="270" y="220" as="geometry" />
