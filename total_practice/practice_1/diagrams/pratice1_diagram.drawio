        <mxCell id="b_p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" value="Forward: logits = model(images)" vertex="1">
          <mxGeometry height="50" width="240" x="270" y="300" as="geometry" />
        </mxCell>
        <mxCell id="b_p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" value="loss = criterion(logits, labels)" vertex="1">
          <mxGeometry height="50" width="240" x="270" y="380" as="geometry" />
        </mxCell>
        <mxCell id="b_d2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" value="loss hữu hạn?" vertex="1">
          <mxGeometry height="60" width="200" x="290" y="460" as="geometry" />
        </mxCell>
        <mxCell id="b_err" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" value="raise FloatingPointError&#xa;(kèm batch_index)" vertex="1">
          <mxGeometry height="70" width="190" x="560" y="460" as="geometry" />
        </mxCell>
        <mxCell id="b_p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" value="loss.backward()" vertex="1">
          <mxGeometry height="50" width="240" x="270" y="610" as="geometry" />
        </mxCell>
        <mxCell id="b_p5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" value="optimizer.step()" vertex="1">
          <mxGeometry height="50" width="240" x="270" y="690" as="geometry" />
        </mxCell>
        <mxCell id="b_p6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" value="Tích lũy: loss_sum += loss*batch_size&#xa;correct += số dự đoán đúng&#xa;sample_count += batch_size" vertex="1">
          <mxGeometry height="70" width="280" x="250" y="790" as="geometry" />
